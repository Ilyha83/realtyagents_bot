# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL)
.env
**/.env
!.env.example
!**/.env.example

# SQLite Databases & Cache (Prevents leaking private client information)
*.db
*.db-wal
*.db-shm
*.sqlite3
data/*.db
data/*.db-wal
data/*.db-shm

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

